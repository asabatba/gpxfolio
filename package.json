{
  "name": "gpx-share",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && vinxi dev",
    "build": "node scripts/copy-maplibre-worker.mjs && vinxi build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:push": "node scripts/ensure-data-dir.mjs && drizzle-kit push --force",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^1.3.2",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.10.1",
    "maplibre-gl": "^6.0.0",
    "solid-js": "^1.9.14",
    "vinxi": "^0.5.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
