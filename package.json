{
  "name": "gpxfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && vinxi dev",
    "build": "node scripts/copy-maplibre-worker.mjs && vinxi build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@garmin/fitsdk": "^21.208.0",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^1.3.2",
    "better-sqlite3": "^13.0.2",
    "exifr": "^7.1.3",
    "fast-xml-parser": "^5.10.1",
    "kysely": "^0.29.4",
    "maplibre-gl": "^6.1.0",
    "sharp": "^0.35.3",
    "solid-js": "^1.9.14",
    "tz-lookup": "^6.1.25",
    "vinxi": "^0.5.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "@types/tz-lookup": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
