# Password for the single admin account (used at /login to create/edit routes).
ADMIN_PASSWORD=change-me

# Secret used to sign the session cookie. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars

# Where the SQLite database lives. Blobs are stored alongside it in <dir>/blobs.
DATABASE_PATH=./data/gpx-share.db

# Public origin, used to build absolute share URLs and OpenGraph tags.
PUBLIC_SITE_URL=http://localhost:3000

# Optional: displayed name of the site owner.
PUBLIC_SITE_NAME=My Routes
